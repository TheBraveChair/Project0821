# ====================================================================
# 2. .NET / C# 项目相关 (Backend, Device, Frontend)
# ====================================================================
# 忽略所有编译输出和临时文件夹
[Bb]in/
[Oo]bj/

# 忽略发布配置文件中的用户凭据
Properties/PublishProfiles/*.pubxml.user

# 忽略用户特定的项目配置文件
*.csproj.user

# 忽略本地开发数据库（如果使用 LocalDB 或 SQLite 临时文件）
*.db
*.db-shm
*.db-wal


# appsettings.Development.json

# ====================================================================
# 3. 前端项目相关 (GUI)
# ====================================================================
# 忽略依赖包目录
**/node_modules/

/GUI/dist/

# 忽略前端本地环境变量文件
.env.local
.env.*.local

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ====================================================================
# 4. 其他敏感/临时文件
# ====================================================================
/Frontend/testpwd
